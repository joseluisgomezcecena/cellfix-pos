{
    "name": "pos-modules/layaway",
    "description": "Complete layaway management module for Ultimate POS systems",
    "type": "library",
    "keywords": [
        "pos",
        "layaway",
        "ultimate-pos",
        "laravel",
        "module",
        "payment",
        "commerce"
    ],
    "homepage": "https://github.com/username/pos-layaway",
    "license": "MIT",
    "authors": [
        {
            "name": "POS Modules Team",
            "email": "support@pos-modules.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9.0|^10.0",
        "nwidart/laravel-modules": "^9.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Modules\\Layaway\\": "src/Modules/Layaway/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\Layaway\\Providers\\LayawayServiceProvider"
            ]
        }
    },
    "scripts": {
        "install-module": "php install.php",
        "verify-installation": "php scripts/verify-installation.php",
        "test": "phpunit tests/"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.0.0"
}